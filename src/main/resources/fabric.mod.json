{
	"schemaVersion": 1,
	"id": "blockbreakhud",
	"version": "1.0.0",
	"name": "Block Break HUD",
	"description": "Adds a progress bar-like HUD to show how much of a block has been mined",
	"authors": [
		"JustAChillGuy"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/modid/icon.png",
	"environment": "*",
	"entrypoints": {
		"client": [
			"com.example.blockbreakhud.BlockBreakHUDClient"
		]
	},
	"mixins": [
		"modid.mixins.json",
		{
			"config": "modid.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.2",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
